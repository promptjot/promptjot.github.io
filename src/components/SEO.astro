---
import type { SupportedLocale } from '../i18n/translations';
import { SUPPORTED_LOCALES } from '../i18n/translations';

interface Props {
  locale: SupportedLocale;
  title: string;
  description: string;
  keywords?: string;
}

const { locale, title, description, keywords } = Astro.props;

const siteRoot = 'https://promptjot.github.io';
const canonicalPath = locale === 'en' ? '/' : `/${locale}/`;
const canonicalUrl = `${siteRoot}${canonicalPath}`;
const ogImage = `${siteRoot}/og-image.png`;
const faviconUrl = `${siteRoot}/favicon.svg`;

const localesList = Object.keys(SUPPORTED_LOCALES) as SupportedLocale[];

// Master Schema.org Graph for Google, Bing, and AI Search Crawlers
const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    // 1. WebSite
    {
      '@type': 'WebSite',
      '@id': `${siteRoot}/#website`,
      url: siteRoot,
      name: 'PromptJot',
      alternateName: ['Prompt Jot', 'PromptJot AI Organizer', 'PromptJot Prompt Vault'],
      description: 'A 100% client-side, zero-server AI prompt management tool. Save, tag, search, and copy AI prompts instantly with absolute privacy.',
      inLanguage: locale,
      publisher: {
        '@id': `${siteRoot}/#organization`,
      },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${siteRoot}/?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },

    // 2. Organization / Creator
    {
      '@type': 'Organization',
      '@id': `${siteRoot}/#organization`,
      name: 'PromptJot',
      url: siteRoot,
      logo: {
        '@type': 'ImageObject',
        url: faviconUrl,
        caption: 'PromptJot Logo',
      },
      sameAs: [
        'https://github.com/promptjot/promptjot.github.io',
        'https://buymeacoffee.com/kisharadilz',
      ],
      founder: {
        '@type': 'Person',
        name: 'Kishan Radilz',
        url: 'https://buymeacoffee.com/kisharadilz',
      },
    },

    // 3. WebApplication
    {
      '@type': 'WebApplication',
      '@id': `${siteRoot}/#webapplication`,
      name: 'PromptJot',
      url: canonicalUrl,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'All Modern Web Browsers (Chrome, Edge, Firefox, Safari, Brave)',
      browserRequirements: 'Requires JavaScript. Requires HTML5 LocalStorage.',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
      },
      featureList: [
        '100% Client-side LocalStorage prompt vault with zero cloud tracking',
        'Sub-millisecond instant real-time search across titles, content, and tags',
        'Dynamic interactive tag aggregation and 1-click filter ribbons',
        '1-Click clipboard copy button with visual state feedback and usage counter',
        'Template variable syntax highlighting like {{VARIABLE}} and [VARIABLE]',
        'Full JSON backup export and merge-capable import functionality',
        'No signup, account registration, or cookies required',
      ],
      creator: {
        '@id': `${siteRoot}/#organization`,
      },
    },

    // 4. SoftwareApplication (UtilityApplication)
    {
      '@type': 'SoftwareApplication',
      '@id': `${siteRoot}/#softwareapplication`,
      name: 'PromptJot',
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Web Browser',
      softwareVersion: '1.0.0',
      description: description,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      author: {
        '@id': `${siteRoot}/#organization`,
      },
    },

    // 5. BreadcrumbList
    {
      '@type': 'BreadcrumbList',
      '@id': `${siteRoot}/#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: siteRoot,
        },
      ],
    },

    // 6. FAQPage (Guarantees Google Rich FAQ SERP Snippets)
    {
      '@type': 'FAQPage',
      '@id': `${siteRoot}/#faq`,
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Where are my AI prompts stored in PromptJot?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'All your prompts are stored 100% locally in your web browser\'s HTML5 LocalStorage. Zero data is ever sent to external cloud servers, databases, or third-party analytics. Your prompts remain strictly private on your device.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can PromptJot work offline without an internet connection?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes! PromptJot is a completely client-side application. Once the page is loaded, all operations—creating, editing, searching, tagging, and copying prompts—run locally in your browser without requiring an active internet connection.',
          },
        },
        {
          '@type': 'Question',
          name: 'How do I backup or transfer my prompt library to another computer?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Simply click the "Export JSON" button at the top of your Prompt Vault to download a clean, structured JSON backup file. On your other computer, open PromptJot and click "Import JSON" to merge or replace your prompts instantly with zero data loss.',
          },
        },
        {
          '@type': 'Question',
          name: 'Does PromptJot support ChatGPT, Claude, and Midjourney prompt templates?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. PromptJot supports prompts for all modern AI models including OpenAI ChatGPT (GPT-4o, o1), Anthropic Claude (Claude 3.5 Sonnet), Midjourney v6, Flux.1, Google Gemini, and Cursor AI. It also highlights template placeholders like {{VARIABLE}} or [VARIABLE] for easy customization.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is PromptJot completely free and open-source?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes, PromptJot is 100% free and open-source under the permissive MIT License. There are no paid tiers, subscriptions, paywalls, or locked features.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does PromptJot compare to cloud-based prompt managers?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Unlike cloud prompt tools that require user accounts and store your proprietary intellectual property on their servers, PromptJot offers zero tracking, sub-millisecond local search speed, total data ownership via JSON, and works completely offline.',
          },
        },
      ],
    },

    // 7. HowTo Schema (Rich Snippet Eligibility for Voice & Search Tutorials)
    {
      '@type': 'HowTo',
      '@id': `${siteRoot}/#howto`,
      name: 'How to Organize and Copy AI Prompts with PromptJot',
      description: 'Step-by-step guide to saving, tagging, searching, and 1-click copying AI prompts locally in your browser with PromptJot.',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Create a Prompt',
          text: 'Click the "New Prompt" button or press "N" on your keyboard to open the editor.',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Add Title, Content, and Tags',
          text: 'Enter your prompt title, template content with {{VARIABLE}} placeholders, and organizational tags like #Coding or #Midjourney.',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Search Instantly',
          text: 'Press "/" or Ctrl+K to search across titles and content, or click any tag pill to filter your vault.',
        },
        {
          '@type': 'HowToStep',
          position: 4,
          name: '1-Click Copy',
          text: 'Click the "Copy" button on any prompt card to instantly transfer it to your clipboard with zero latency.',
        },
      ],
    },
  ],
};
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<meta name="author" content="Kishan Radilz" />

<!-- Google & Search Engine Robots Directives -->
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook / LinkedIn / Discord -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="PromptJot - Free Local AI Prompt Library & Organizer" />
<meta property="og:site_name" content="PromptJot" />
<meta property="og:locale" content={locale === 'ja' ? 'ja_JP' : `${locale}_${locale.toUpperCase()}`} />

<!-- Twitter Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="PromptJot - Free Local AI Prompt Library & Organizer" />

<!-- Hreflang Alternates for Multilingual SEO -->
{localesList.map((loc) => {
  const href = loc === 'en' ? `${siteRoot}/` : `${siteRoot}/${loc}/`;
  return <link rel="alternate" hreflang={loc} href={href} />;
})}
<link rel="alternate" hreflang="x-default" href={`${siteRoot}/`} />

<!-- Native Dynamic JSON-LD Master Graph Schema Injection -->
<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
