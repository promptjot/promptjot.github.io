---
import type { SupportedLocale } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = translations[locale] || translations.en;
const hero = t.hero;
---

<section class="relative overflow-hidden pt-8 pb-4 sm:pt-12 sm:pb-6">
  <!-- Warm organic background glow -->
  <div class="pointer-events-none absolute -top-24 left-1/2 -z-10 -translate-x-1/2 transform-gpu blur-3xl" aria-hidden="true">
    <div class="aspect-[1155/678] w-[48rem] max-w-none bg-gradient-to-tr from-[#2A7C13]/15 to-[#76C457]/20 opacity-50 dark:from-[#2A7C13]/25 dark:to-[#76C457]/15"></div>
  </div>

  <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
    
    <!-- Privacy Badge -->
    <div class="inline-flex items-center gap-2 rounded-full border border-[#FBE6C2] bg-white/80 px-3 py-1 text-xs font-semibold text-[#2A7C13] shadow-xs backdrop-blur-xs dark:border-[#233d1f] dark:bg-[#121e10]/80 dark:text-[#FFF8CF]">
      <span class="flex h-1.5 w-1.5 rounded-full bg-[#76C457]"></span>
      <span>{hero.badge}</span>
    </div>

    <!-- Main H1 Headline for SEO -->
    <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-[#2A7C13] dark:text-[#FFF8CF] sm:text-5xl lg:text-6xl">
      {hero.titlePrefix}{' '}
      <span class="bg-gradient-to-r from-[#2A7C13] via-[#43872a] to-[#76C457] bg-clip-text text-transparent dark:from-[#76C457] dark:via-[#aee297] dark:to-[#FFF8CF]">
        {hero.titleHighlight}
      </span>
    </h1>

    <!-- Subtitle / Meta Description reinforcement -->
    <p class="mx-auto mt-3 max-w-2xl text-sm sm:text-base text-[#527045] dark:text-[#b3cca7] leading-relaxed">
      {hero.subtitle}
    </p>

    <!-- Key Metrics Pills -->
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3 sm:gap-6 text-xs">
      <div class="flex items-center gap-2 rounded-xl border border-[#FBE6C2] bg-white/70 px-3 py-1.5 text-[#2A7C13] dark:border-[#233d1f] dark:bg-[#121e10]/70 dark:text-[#FFF8CF]">
        <div class="flex h-5 w-5 items-center justify-center rounded-md bg-[#76C457]/20 text-[#2A7C13] dark:text-[#76C457]">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <span>{hero.statPrivacyValue}</span>
      </div>

      <div class="flex items-center gap-2 rounded-xl border border-[#FBE6C2] bg-white/70 px-3 py-1.5 text-[#2A7C13] dark:border-[#233d1f] dark:bg-[#121e10]/70 dark:text-[#FFF8CF]">
        <div class="flex h-5 w-5 items-center justify-center rounded-md bg-[#2A7C13]/10 text-[#2A7C13] dark:bg-[#76C457]/15 dark:text-[#76C457]">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </div>
        <span>{hero.statLatencyValue}</span>
      </div>

      <div class="flex items-center gap-2 rounded-xl border border-[#FBE6C2] bg-white/70 px-3 py-1.5 text-[#2A7C13] dark:border-[#233d1f] dark:bg-[#121e10]/70 dark:text-[#FFF8CF]">
        <div class="flex h-5 w-5 items-center justify-center rounded-md bg-[#76C457]/20 text-[#2A7C13] dark:text-[#76C457]">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
        </div>
        <span>Zero Vendor Lock-in (JSON)</span>
      </div>
    </div>

  </div>
</section>
