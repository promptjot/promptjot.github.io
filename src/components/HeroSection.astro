---
import type { SupportedLocale } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = translations[locale] || translations.en;
const hero = t.hero;
---

<section class="pt-6 pb-2 text-center">
  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#2A7C13] dark:text-[#FFF8CF]">
      {hero.titlePrefix}{' '}
      <span class="text-[#76C457]">
        {hero.titleHighlight}
      </span>
    </h1>
    <p class="mx-auto mt-1 max-w-xl text-xs sm:text-sm text-[#527045] dark:text-[#b3cca7]">
      {hero.subtitle}
    </p>
  </div>
</section>
