---
import type { SupportedLocale } from '../i18n/translations';
import { SUPPORTED_LOCALES, translations } from '../i18n/translations';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = translations[locale];
const currentLocaleConfig = SUPPORTED_LOCALES[locale];
const homeUrl = locale === 'en' ? '/' : `/${locale}/`;
---

<header class="sticky top-0 z-50 w-full border-b border-[#FBE6C2] bg-[#FFF8CF]/90 backdrop-blur-md transition-colors dark:border-[#233d1f] dark:bg-[#0a1309]/90">
  <div class="mx-auto flex h-15 sm:h-16 max-w-7xl items-center justify-between px-3.5 sm:px-6 lg:px-8">
    
    <!-- Left: Brand Logo & Privacy Badge -->
    <div class="flex items-center gap-2.5 sm:gap-4">
      <a href={homeUrl} class="group flex items-center gap-2 sm:gap-2.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#76C457] rounded-xl py-1 px-1">
        <div class="relative flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-xl bg-gradient-to-br from-[#2A7C13] via-[#3d7d20] to-[#76C457] text-[#FFF8CF] shadow-md shadow-[#2A7C13]/25 transition-transform group-hover:scale-105">
          <svg class="h-4 w-4 sm:h-5 sm:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
          <span class="absolute -top-0.5 -right-0.5 flex h-2 w-2 sm:h-2.5 sm:w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#76C457] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 sm:h-2.5 sm:w-2.5 bg-[#76C457]"></span>
          </span>
        </div>
        <div class="flex flex-col">
          <span class="text-base sm:text-lg font-bold tracking-tight text-[#2A7C13] transition-colors group-hover:text-[#76C457] dark:text-[#FFF8CF] dark:group-hover:text-[#76C457]">
            Prompt<span class="text-[#76C457]">Jot</span>
          </span>
          <span class="hidden text-[10px] font-medium tracking-wider uppercase text-[#527045] dark:text-[#b3cca7] lg:block -mt-1">
            {t.nav.logoSubtitle}
          </span>
        </div>
      </a>

      <!-- Privacy Pill Badge (Desktop only to keep mobile/tab simple with icons) -->
      <div class="hidden items-center gap-1.5 rounded-full border border-[#FBE6C2] bg-[#FBE6C2]/60 px-2.5 py-0.5 text-[11px] font-medium text-[#2A7C13] dark:border-[#233d1f] dark:bg-[#121e10] dark:text-[#FFF8CF] xl:inline-flex" title="100% Client-Side. Zero data transmitted to any external servers.">
        <svg class="h-3 w-3 text-[#76C457]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
        <span>{t.nav.privacyBadge}</span>
      </div>
    </div>

    <!-- Right: Minimalist Icon-First Actions (Mobile & Tablet optimized) -->
    <div class="flex items-center gap-1.5 sm:gap-2.5">
      
      <!-- Language Dropdown: Icon-only on mobile & tab, label on desktop -->
      <div class="relative" id="lang-dropdown-wrapper">
        <button
          type="button"
          id="lang-dropdown-btn"
          aria-expanded="false"
          aria-haspopup="true"
          class="flex h-8 sm:h-9 items-center gap-1 sm:gap-1.5 rounded-xl border border-[#FBE6C2] bg-white px-2 sm:px-2.5 text-xs font-medium text-[#173d0a] hover:border-[#76C457] hover:text-[#2A7C13] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#76C457] dark:border-[#233d1f] dark:bg-[#121e10] dark:text-[#FFF8CF] dark:hover:border-[#76C457] transition-colors"
          title={t.nav.switchLanguage}
          aria-label={t.nav.switchLanguage}
        >
          <span class="text-base sm:text-sm leading-none">{currentLocaleConfig.flag}</span>
          <span class="hidden font-medium lg:inline">{currentLocaleConfig.nativeName}</span>
          <svg class="h-3.5 w-3.5 text-[#527045] dark:text-[#b3cca7] transition-transform duration-200" id="lang-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <!-- Dropdown menu -->
        <div
          id="lang-menu"
          class="hidden absolute right-0 mt-2 w-44 origin-top-right rounded-2xl border border-[#FBE6C2] bg-white p-1.5 shadow-xl shadow-[#2A7C13]/10 focus:outline-none dark:border-[#233d1f] dark:bg-[#121e10] dark:shadow-black/60 z-50"
          role="menu"
        >
          {Object.entries(SUPPORTED_LOCALES).map(([code, cfg]) => {
            const path = code === 'en' ? '/' : `/${code}/`;
            const isCurrent = code === locale;
            return (
              <a
                href={path}
                role="menuitem"
                class={`flex items-center justify-between rounded-xl px-2.5 py-2 text-xs font-medium transition-colors ${
                  isCurrent
                    ? 'bg-[#FBE6C2] text-[#2A7C13] font-semibold dark:bg-[#233d1f] dark:text-[#FFF8CF]'
                    : 'text-[#173d0a] hover:bg-[#FFF8CF] dark:text-[#b3cca7] dark:hover:bg-[#1a2b17] dark:hover:text-[#FFF8CF]'
                }`}
              >
                <span class="flex items-center gap-2">
                  <span class="text-sm leading-none">{cfg.flag}</span>
                  <span>{cfg.nativeName}</span>
                </span>
                {isCurrent && (
                  <svg class="h-3.5 w-3.5 text-[#76C457]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                )}
              </a>
            );
          })}
        </div>
      </div>

      <!-- Theme Switcher: Minimal Icon Button -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="relative flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-xl border border-[#FBE6C2] bg-white text-[#2A7C13] hover:border-[#76C457] hover:text-[#76C457] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#76C457] dark:border-[#233d1f] dark:bg-[#121e10] dark:text-[#FFF8CF] dark:hover:border-[#76C457] dark:hover:text-[#76C457] transition-colors"
        aria-label={t.nav.toggleTheme}
        title={t.nav.toggleTheme}
      >
        <!-- Sun icon (for dark mode -> switch to light) -->
        <svg class="hidden h-4 w-4 dark:block text-[#FFF8CF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon (for light mode -> switch to dark) -->
        <svg class="block h-4 w-4 dark:hidden text-[#2A7C13]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Support the Developer CTA: Simple Icon on Mobile/Tablet, Full CTA on Desktop -->
      <a
        href="https://buymeacoffee.com/kisharadilz"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative inline-flex h-8 sm:h-9 items-center justify-center gap-1.5 rounded-xl bg-gradient-to-r from-[#2A7C13] to-[#76C457] px-2.5 sm:px-3 text-xs font-semibold text-[#FFF8CF] shadow-sm shadow-[#2A7C13]/20 transition-all hover:opacity-95 hover:shadow-md hover:shadow-[#76C457]/30 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#76C457]"
        title="Buy me a coffee to support PromptJot development"
        aria-label={t.nav.supportDev}
      >
        <span class="text-sm transition-transform group-hover:scale-110">☕</span>
        <span class="hidden lg:inline">{t.nav.supportDev}</span>
      </a>

    </div>
  </div>
</header>

<script is:inline>
  const themeBtn = document.getElementById('theme-toggle-btn');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('promptjot_theme', isDark ? 'dark' : 'light');
    });
  }

  const langBtn = document.getElementById('lang-dropdown-btn');
  const langMenu = document.getElementById('lang-menu');
  const langChevron = document.getElementById('lang-chevron');

  if (langBtn && langMenu) {
    langBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = langBtn.getAttribute('aria-expanded') === 'true';
      langBtn.setAttribute('aria-expanded', String(!isExpanded));
      langMenu.classList.toggle('hidden');
      if (langChevron) langChevron.classList.toggle('rotate-180');
    });

    document.addEventListener('click', (e) => {
      if (!langMenu.classList.contains('hidden')) {
        langMenu.classList.add('hidden');
        langBtn.setAttribute('aria-expanded', 'false');
        if (langChevron) langChevron.classList.remove('rotate-180');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !langMenu.classList.contains('hidden')) {
        langMenu.classList.add('hidden');
        langBtn.setAttribute('aria-expanded', 'false');
        if (langChevron) langChevron.classList.remove('rotate-180');
      }
    });
  }
</script>
