---
import type { SupportedLocale } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = translations[locale];
---

<footer class="mt-20 border-t border-[#FBE6C2] bg-[#FFF8CF] py-12 transition-colors dark:border-[#233d1f] dark:bg-[#070e06]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-12">
      
      <!-- Brand & Mission Column -->
      <div class="md:col-span-6 flex flex-col gap-3">
        <div class="flex items-center gap-2">
          <div class="flex h-7 w-7 items-center justify-center rounded-xl bg-gradient-to-br from-[#2A7C13] to-[#76C457] text-[#FFF8CF] shadow-sm">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="4 17 10 11 4 5"></polyline>
              <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
          </div>
          <span class="text-base font-bold text-[#2A7C13] dark:text-[#FFF8CF]">
            Prompt<span class="text-[#76C457]">Jot</span>
          </span>
        </div>
        <p class="text-xs text-[#527045] dark:text-[#b3cca7] leading-relaxed max-w-md">
          {t.footer.description}
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-[#FBE6C2] bg-white px-2.5 py-1 text-[11px] font-medium text-[#2A7C13] dark:border-[#233d1f] dark:bg-[#121e10] dark:text-[#FFF8CF]">
            <span class="h-1.5 w-1.5 rounded-full bg-[#76C457]"></span>
            {t.footer.privacyGuarantee}
          </span>
        </div>
      </div>

      <!-- Shortcuts & Tech Specs -->
      <div class="md:col-span-3 flex flex-col gap-2.5">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-[#2A7C13] dark:text-[#FFF8CF]">
          Keyboard Shortcuts
        </h4>
        <ul class="text-xs text-[#527045] dark:text-[#b3cca7] space-y-2">
          <li class="flex items-center justify-between">
            <span>Quick Search</span>
            <kbd class="rounded-lg border border-[#FBE6C2] bg-white px-2 py-0.5 text-[10px] font-mono font-medium text-[#2A7C13] dark:border-[#233d1f] dark:bg-[#121e10] dark:text-[#FFF8CF] shadow-xs">/</kbd>
          </li>
          <li class="flex items-center justify-between">
            <span>New Prompt</span>
            <kbd class="rounded-lg border border-[#FBE6C2] bg-white px-2 py-0.5 text-[10px] font-mono font-medium text-[#2A7C13] dark:border-[#233d1f] dark:bg-[#121e10] dark:text-[#FFF8CF] shadow-xs">N</kbd>
          </li>
          <li class="flex items-center justify-between">
            <span>Close Modal</span>
            <kbd class="rounded-lg border border-[#FBE6C2] bg-white px-2 py-0.5 text-[10px] font-mono font-medium text-[#2A7C13] dark:border-[#233d1f] dark:bg-[#121e10] dark:text-[#FFF8CF] shadow-xs">Esc</kbd>
          </li>
        </ul>
      </div>

      <!-- Developer & Support Column -->
      <div class="md:col-span-3 flex flex-col gap-3">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-[#2A7C13] dark:text-[#FFF8CF]">
          Support & Links
        </h4>
        <ul class="text-xs text-[#527045] dark:text-[#b3cca7] space-y-2.5">
          <li>
            <a
              href="https://buymeacoffee.com/kisharadilz"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 font-medium text-[#2A7C13] hover:text-[#76C457] dark:text-[#76C457] dark:hover:text-[#FFF8CF] transition-colors"
            >
              <span>☕</span>
              <span>{t.footer.supportCta}</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/promptjot/promptjot.github.io"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 hover:text-[#2A7C13] dark:hover:text-[#FFF8CF] transition-colors"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
              </svg>
              <span>GitHub Repository</span>
            </a>
          </li>
          <li class="text-[11px] text-[#527045]/80 dark:text-[#b3cca7]/70">
            {t.footer.builtWith}
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="mt-8 flex flex-col items-center justify-between border-t border-[#FBE6C2] pt-6 text-xs text-[#527045] dark:border-[#233d1f] dark:text-[#b3cca7] sm:flex-row">
      <p>© {new Date().getFullYear()} PromptJot. {t.footer.allRights}</p>
      <p class="mt-2 sm:mt-0 font-medium text-[#2A7C13] dark:text-[#FFF8CF]">
        Designed with privacy in mind.
      </p>
    </div>
  </div>
</footer>
